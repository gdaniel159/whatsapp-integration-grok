generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageDirection {
  IN
  OUT
}

enum WaSessionStatus {
  DISCONNECTED
  QR
  CONNECTED
}

enum AiMode {
  AI
  MANUAL
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  INTERESTED
  QUOTED
  WON
  LOST
}

enum CommercialActivityType {
  CONTACT_CREATED
  STATUS_CHANGED
  NOTES_UPDATED
  TAGS_UPDATED
}

enum CommercialActivitySource {
  SYSTEM
  USER
  SEED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Contact {
  id                   String               @id @default(cuid())
  waJid                String               @unique
  phoneE164            String?              @unique
  displayName          String?
  profileName          String?
  firstSeenAt          DateTime             @default(now())
  lastSeenAt           DateTime?
  leadStatus           LeadStatus           @default(NEW)
  notes                String?
  tags                 String[]             @default([])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  conversations        Conversation[]
  commercialActivities CommercialActivity[]
}

model CommercialActivity {
  id          String                    @id @default(cuid())
  contactId   String
  contact     Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        CommercialActivityType
  source      CommercialActivitySource
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime                  @default(now())

  @@index([contactId, createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  remoteJid     String    @unique
  name          String?
  lastMessageAt DateTime?
  aiMode        AiMode    @default(AI)
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@index([contactId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  timestamp      DateTime
  waMessageId    String?
  rawMeta        Json?

  @@index([conversationId, timestamp])
}

model WhatsAppSession {
  id        String          @id @default("default")
  status    WaSessionStatus @default(DISCONNECTED)
  lastQrAt  DateTime?
  updatedAt DateTime        @updatedAt
}

model KnowledgeBase {
  id        String   @id @default("default")
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model BotSettings {
  id                      String   @id @default("default")
  welcomeMessage          String   @db.Text
  firstAction             String   @db.Text
  hfModel                 String?
  globalAutoReplyEnabled  Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}
